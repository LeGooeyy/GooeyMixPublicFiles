import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.play.PauseSubState;
import funkin.play.character.CharacterType;
import funkin.play.GameOverSubState;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import flixel.FlxG;

class GooeyQTCharacter extends MultiAnimateAtlasCharacter {
	function new() {
		super('gooey-qt');
	}

	function onCreate(event:ScriptEvent) {
		super.onCreate(event);
		GameOverSubState.musicSuffix = '-gooey';
		GameOverSubState.blueBallSuffix = '-gooey';
		PauseSubState.musicSuffix = '-gooey';
	}

	public var randomInt:Int;

	override function getDeathQuote():Null<String> {
		switch (PlayState.instance?.currentStage?.getDad()?.characterId) {
			case "QT":
				randomInt = FlxG.random.int(1, 7);
				gameoverSound = Paths.sound('qtgameover/' + FlxG.save.data.qtRewiredLang + '/bf/qtGameover-' + randomInt);
				return gameoverSound;
			case "tankman":
				var randomCensor:Array<Int> = [];

				if (!Preferences.naughtyness) {
					// 1 - cock
					// 3 - shitty
					// 8 - shit
					// 13 - fuck
					// 17 - shit, asshole
					// 21 - fucking
					randomCensor = [1, 3, 8, 13, 17, 21];
				} else if (Constants.CENSOR_EXPLETIVES) {
					randomCensor = [13, 21];
				}

				return Paths.sound('jeffGameover/jeffGameover-' + FlxG.random.int(1, 25, randomCensor));
			default:
				return null;
		}
	}

	function onNoteHit(event:HitNoteScriptEvent) {
		if (event.eventCanceled) {
			// onNoteHit event was cancelled by the gameplay module.
			return;
		}

		// Override the hit note animation.
		switch (event.note.kind) {
			case "hey":
				holdTimer = 0;
				this.playAnimation('hey', true, true);
				return;
			case "cheer":
				holdTimer = 0;
				this.playAnimation('cheer', true, true);
				return;
			case "alt":
				holdTimer = 0;
				this.playSingAnimation(event.note.noteData.getDirection(), false, 'alt');
				return;
			default:
				super.onNoteHit(event);
		}
	}

	function playAnimation(name:String, restart:Bool, ignoreOther:Bool) {
		super.playAnimation(name, restart, ignoreOther);
		if (name == "deathConfirm") {
			gooeyRetry = FunkinSound.load(Paths.music('gameplay/gameover/gameOverEnd-gooeyReal'), true);
			gooeyRetry.volume = 1;
			gooeyRetry.play(false);
		}
	}

	override function onSongRetry(event:ScriptEvent):Void {
		super.onSongRetry(event);
		GameOverSubState.musicSuffix = '-gooey';
		GameOverSubState.blueBallSuffix = '-gooey';
		PauseSubState.musicSuffix = '-gooey';
	}
}
