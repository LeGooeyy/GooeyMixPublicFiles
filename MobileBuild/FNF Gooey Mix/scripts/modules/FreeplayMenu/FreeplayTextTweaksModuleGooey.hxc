import funkin.modding.module.Module;
import funkin.util.ReflectUtil;
import flixel.FlxG;
import funkin.modding.PolymodHandler;

class FreeplayTextTweaksModuleGooey extends Module {
	public function new() {
		super('FreeplayTextTweaksModuleGooey', 1099999);
	}

	override function onUpdate(event) {
		super.onUpdate(event);

		var modTitles:Array<String> = [];
		for (id in PolymodHandler.loadedModIds) {
			var modMeta:ModMetadata = PolymodHandler.modFileSystem.getMetadata(id);
			if (modMeta != null && !modTitles.contains(modMeta.title))
				modTitles.push(modMeta.title);
		}

		if (modTitles.contains("QT: Rewired")) {
			var sub = FlxG.state.subState;
			if (sub == null || ReflectUtil.getClassNameOf(sub) != "funkin.ui.freeplay.FreeplayState")
				return;

			var capsule = sub.grpCapsules.members[sub.curSelected];
			var data = capsule.freeplayData;
			var id = (data != null) ? data.levelId : null;

			if (sub.ostName != null) {
				if (FlxG.state.subState.currentCharacterId == 'gooey')
				{
					switch (id) {
						case "QTWeek":
							sub.ostName.text = "GOOEY/QT:R OST";
						default:
							sub.ostName.text = "GOOEY MIX OST";
					}
				}	
				if (FlxG.state.subState.currentCharacterId == 'bf' || FlxG.state.subState.currentCharacterId == 'pico') {
					switch (id) {
						case "QTWeek":
							sub.ostName.text = "QT:R OST";
						case "week60037":
							sub.ostName.text = "GOOEY MIX OST";
						default:
							sub.ostName.text = "OFFICIAL OST";
					}
				}
			}
		}
	}
}
