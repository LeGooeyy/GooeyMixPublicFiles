import funkin.play.stage.Stage;
import funkin.graphics.shaders.DropShadowShader;
import funkin.play.character.CharacterType;
import flixel.FlxG;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxTimerManager;

import funkin.play.PlayState;
import flixel.addons.display.FlxRuntimeShader;
import openfl.filters.ShaderFilter;
import openfl.utils.Assets;

class natCrystalStage extends Stage
{
	function new()
	{
		super('natCrystal');
	}



	function onCountdownStart(event:ScriptEvent) {
			super.onCountdownStart(event);
			getBoyfriend().setColorTransform(color.redFloat, color.greenFloat, color.blueFloat, 1.0, 0, 0, 0, 0);
	}


	function buildStage()
	{
		super.buildStage();

		var floorLight = getNamedProp('floorLight');
		floorLight.blend = 0;
		floorLight.alpha = 0.3; 

		var bottomCrystalLight = getNamedProp('bottomCrystalLight');
		bottomCrystalLight.blend = 0;

		
		var natCrystalLight = getNamedProp('natCrystalLight');
		natCrystalLight.blend = 0; 

		var natCrystalLight2 = getNamedProp('natCrystalLight2');
		natCrystalLight2.blend = 0; 
		natCrystalLight2.alpha = 0;

		var overlay1 = getNamedProp('overlay1');
		overlay1.blend = 9; 

		var overlay2 = getNamedProp('overlay2');
		overlay2.blend = 9; 

		var overlay3 = getNamedProp('overlay3');
		overlay3.blend = 9;
		overlay3.alpha = 0;

		FlxTween.tween(getNamedProp('natCrystalLight'), {y: getNamedProp('natCrystalLight').y +50}, 5, {ease: FlxEase.quadInOut, type: 4});
		FlxTween.tween(getNamedProp('natCrystalLight2'), {y: getNamedProp('natCrystalLight2').y +50}, 5, {ease: FlxEase.quadInOut, type: 4});
		FlxTween.tween(getNamedProp('natCrystal'), {y: getNamedProp('natCrystal').y +50}, 5, {ease: FlxEase.quadInOut, type: 4});
	}

	 // var funnyShader = new FlxRuntimeShader(Assets.getText(Paths.frag("MultiplyRim")), null);
   // var funnyFilter = new ShaderFilter(funnyShader);
  
    override function onSongLoaded(ev){
       // funnyShader.setFloat('test1', 0);
		//funnyShader.setString('test2', 0);
		///funnyShader.setArray ('test3', 0);
		//PlayState.instance.camGame.filters = [funnyFilter];  
    }

	override function addCharacter(character:BaseCharacter, charType:CharacterType):Void {
		// Apply the shader automatically to each character as it gets added.
		super.addCharacter(character, charType);
		trace('Applied stage shader to ' + character.characterName);
if (FlxG.save.data.gooeyShaders != false)
	{
		var rim = new DropShadowShader();
		rim.setAdjustColor(-80, -24, -5, -10);
		//brightness  hue  contrast  saturation
   		rim.color = 0xFFEF72F9;
		character.shader = rim;
		rim.attachedSprite = character;
		//rim.threshold = -1;

		switch(charType){
			case CharacterType.BF:

				rim.angle = 112.5;

				character.animation.onFrameChange.add(function() {
					if (getBoyfriend() != null)
					{
      			rim.updateFrameInfo(getBoyfriend().frame);
					}
    		});

			case CharacterType.GF:

				rim.angle = 90;
				//rim.color = 0xFF000000;

				character.animation.onFrameChange.add(function() {
      		rim.updateFrameInfo(getGirlfriend().frame);
    		});


			case CharacterType.DAD:

				rim.angle = 112.5;
				character.animation.onFrameChange.add(function() {
      		rim.updateFrameInfo(getDad().frame);
    		});

			default:

		}
		}

	}

	function onSongRetry(event:ScriptEvent) {
		super.onSongRetry(event);
		if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft") {
			PlayState.instance.currentStage.getNamedProp('bottomCrystalLight').alpha = 0.3;
			PlayState.instance.currentStage.getNamedProp('natCrystalLight2').alpha = 0;
			PlayState.instance.currentStage.getNamedProp('overlay3').alpha = 0;
		}
	}

	function onStepHit(event:SongTimeScriptEvent):Void {
		super.onStepHit(event);
		if (PlayState.instance.currentSong.id.toLowerCase() == "starcraft") {
			if (event.step == 885) {
				FlxTween.tween(PlayState.instance.currentStage.getNamedProp('bottomCrystalLight'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(PlayState.instance.currentStage.getNamedProp('natCrystalLight2'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});
				FlxTween.tween(PlayState.instance.currentStage.getNamedProp('overlay3'), {alpha: 1}, 2.8, {ease: FlxEase.quartin});
			}
			if (event.step == 1182) {
				FlxTween.tween(PlayState.instance.currentStage.getNamedProp('bottomCrystalLight'), {alpha: 0.3}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(PlayState.instance.currentStage.getNamedProp('natCrystalLight2'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
				FlxTween.tween(PlayState.instance.currentStage.getNamedProp('overlay3'), {alpha: 0}, 1.2, {ease: FlxEase.quartin});
			}
		}
	}


}
