import flixel.math.FlxPoint;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import funkin.play.PlayState;
import flixel.FlxG;

// a unique object for santa getting KILLED
class TankmanGooeyStress extends FunkinSprite
{
  public function new(x:Float, y:Float)
  {
    super(x, y);

    loadTextureAtlas("erect/cutscene/StressCutTankGooey", "week7");
  }
  
  public function playCutscene():Void
  {
    this.animation.play("StressGooeyTankman");
  }
}
