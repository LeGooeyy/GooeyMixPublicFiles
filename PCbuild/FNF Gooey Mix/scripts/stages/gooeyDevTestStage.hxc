import funkin.play.stage.Stage;
import funkin.play.PlayState;

class GooeyDevTestStageStage extends Stage
{
  function new()
  {
    super('gooeyDevTestStage');
  }

  var testingForPlayer = false;

  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (testingForPlayer)
    {
      if (PlayState.instance.currentStage.getGirlfriend() != null)
      {
        PlayState.instance.currentStage.getGirlfriend().flipX = false;
        PlayState.instance.currentStage.getGirlfriend().alpha = 0.6;
        // PlayState.instance.currentStage.getBoyfriend().flipX = false;
        PlayState.instance.currentStage.getDad().alpha = 0;
      }
    }
    else
    {
      if (PlayState.instance.currentStage.getGirlfriend() != null)
      {
        // PlayState.instance.currentStage.getGirlfriend().flipX = true;
        PlayState.instance.currentStage.getGirlfriend().alpha = 0.6;
        PlayState.instance.currentStage.getBoyfriend().flipX = false;
        PlayState.instance.currentStage.getBoyfriend().alpha = 0;
      }
    }
    PlayState.instance.comboPopUps.offsets = [-450, 350];
  }
}
